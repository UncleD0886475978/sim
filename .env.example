# Sim-AI runs a LOCAL model — no API key is needed, and nothing is sent to
# a cloud AI provider. Copy this file to .env and adjust if you want;
# the defaults below work out of the box with `docker compose up`.

# Model name the backend asks the model server for. Must match the
# --alias given to llama-server in docker-compose.yml.
SIM_MODEL=gemma-4-E4B-it

# OpenAI-compatible base URL of the local llama-server.
# Inside Docker Compose the backend overrides this with
# http://model:8080/v1 (the `model` service). Use the value below only
# if you run the backend outside Docker against a llama-server on the host.
LLM_BASE_URL=http://localhost:8080/v1

# Gemma 4 E4B quantization downloaded on first start (from
# ggml-org/gemma-4-E4B-it-GGUF on Hugging Face).
#   Q8_0 ≈ 8.59 GB download, needs 16 GB+ RAM (default, best quality)
#   Q4_0 ≈ ~5 GB, lighter/faster if RAM is tight
# First start downloads the model (~8.6 GB for Q8_0) into a Docker volume;
# later starts reuse it.
GEMMA_QUANT=Q8_0

# Optional: only needed if you protect llama-server with your own API key
# or proxy. Leave unset for the standard local setup.
# LLM_API_KEY=
